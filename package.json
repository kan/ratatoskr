{
  "name": "ratatoskr",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:roji": "roji run ratatoskr -- node scripts/dev.mjs",
    "build": "pnpm -C web build",
    "icons": "node scripts/build-icons.mjs",
    "deploy": "pnpm build && pnpm db:migrate:remote && wrangler deploy -c wrangler.deploy.json",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/deploy-config.mjs && wrangler d1 migrations apply DB --remote -c wrangler.deploy.json",
    "db:console": "wrangler d1 execute DB --local --command",
    "cf-typegen": "wrangler types --strict-vars=false",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json --noEmit && pnpm -C web typecheck",
    "lint": "eslint . && prettier --check .",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.1",
    "postal-mime": "^4.2.1"
  }
}
