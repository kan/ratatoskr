{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    // E2E から web 側のモジュール（keymap の定義やキャッシュ名）を import する。
    // その先が使っているエイリアスをここでも解決できるようにしておく
    "paths": {
      "@/*": ["./web/src/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["e2e/**/*.ts", "playwright.config.ts", "shared/**/*.ts"]
}
