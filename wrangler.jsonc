{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ratatoskr",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",

  // 静的アセットは Workers 側で配信する（Pages は使わない。docs/DESIGN.md §2）
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    // SPA なので、未知のパスは index.html にフォールバックする
    "not_found_handling": "single-page-application",
    // /api/* は必ず Worker に渡す。
    // single-page-application は「ナビゲーション要求（Sec-Fetch-Mode: navigate）で
    // アセットに一致しないもの」を Worker より先に index.html へ倒す。これを指定しないと、
    // リンクを踏んで開く経路（OPML の書き出し）だけ API が index.html を返す
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ratatoskr",
      // `wrangler d1 create ratatoskr` の出力で置き換える
      "database_id": "REPLACE_ME",
      "migrations_dir": "migrations"
    }
  ],

  // 全文取得のとき、記事ページのどこが本文かを 1 フィードにつき 1 回だけ判定させる
  // （M7。判定結果は feeds.full_text_selector に残し、以降の記事は呼ばずに引く）
  "ai": {
    "binding": "AI"
  },

  "triggers": {
    // クローラ。1 回の実行で処理するフィード数は必ず LIMIT で絞ること
    // （サブリクエスト上限。docs/DESIGN.md §5）
    "crons": ["*/5 * * * *"]
  },

  "observability": {
    "enabled": true
  },

  "vars": {
    // Cloudflare Access の検証に使う。値は本番の設定に合わせる
    "ACCESS_TEAM_DOMAIN": "REPLACE_ME.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_ME"
  },

  "dev": {
    "port": 8787
  }
}
