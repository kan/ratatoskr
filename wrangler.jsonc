{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ratatoskr",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",

  // 静的アセットは Workers 側で配信する（Pages は使わない。docs/DESIGN.md §2）
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    // SPA なので、未知のパスは index.html にフォールバックする
    "not_found_handling": "single-page-application",
    // /api/* は必ず Worker に渡す。
    // single-page-application は「ナビゲーション要求（Sec-Fetch-Mode: navigate）で
    // アセットに一致しないもの」を Worker より先に index.html へ倒す。これを指定しないと、
    // リンクを踏んで開く経路（OPML の書き出し）だけ API が index.html を返す
    "run_worker_first": ["/api/*"]
  },

  // database_id はここに書かない。**このリポジトリは公開なので、アカウント固有の値を
  // 追跡させない。** デプロイ時に scripts/deploy-config.mjs が .prod.vars（git 管理外）の
  // D1_DATABASE_ID を差し込んだ設定を .wrangler/ に書き出し、そちらを使う。
  // ローカル開発とテストは id を要らないので、この設定のままで動く
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ratatoskr",
      "migrations_dir": "migrations"
    }
  ],

  // 全文取得のとき、記事ページのどこが本文かを 1 フィードにつき 1 回だけ判定させる
  // （M7。判定結果は feeds.full_text_selector に残し、以降の記事は呼ばずに引く）
  "ai": {
    "binding": "AI"
  },

  "triggers": {
    // 1 つ目はクローラ。1 回の実行で処理するフィード数は必ず LIMIT で絞ること
    // （サブリクエスト上限。docs/DESIGN.md §5）。
    //
    // 2 つ目は保持期間の掃除（M9）。1 日 1 回で足りるものを 5 分毎の実行に混ぜない。
    // **src/index.ts の RETENTION_CRON と同じ文字列にすること**（どちらの仕事かは
    // event.cron で振り分ける）。時刻は UTC なので 02:23 JST にあたる
    "crons": ["*/5 * * * *", "23 17 * * *"]
  },

  "observability": {
    "enabled": true
  },

  // Cloudflare Access の検証に使う 2 つ。**ここには名前だけ置き、値は空にしておく。**
  // どちらもアカウント固有の値なので、公開リポジトリに自分のチーム名とアプリ ID を残さない。
  // 実際の値は database_id と同じ手口で、デプロイ時に scripts/deploy-config.mjs が
  // .prod.vars（git 管理外）から wrangler.deploy.json へ差し込む。
  //
  // **secret ではなく vars なのは、デプロイのたびに必ず渡す運用だから。** secret は
  // 「渡さなければ前の版から引き継ぐ」仕組みで、Worker がまだ無い初回デプロイでは
  // 引き継ぎ元が無く止まる。毎回渡すなら secret を選ぶ利点（消えない）は得られず、
  // 初回が詰む欠点だけが残る。
  //
  // 名前をここに置くと Env の型がこの宣言から作られる（.dev.vars の中身に依存しない）。
  // 値が空なので `wrangler types` には --strict-vars=false が要る（package.json）。
  // ローカルの値は .dev.vars（git 管理外）に置くと、こちらを上書きする
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },

  "dev": {
    "port": 8787
  }
}
